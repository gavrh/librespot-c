#ifndef LIBRESPOT_PLAYBACK_H
#define LIBRESPOT_PLAYBACK_H

#include <librespot/core.h>
#include <librespot/error.h>
#include <stddef.h>
#include <stdint.h>
#include <stdbool.h>

#ifdef __cplusplus
extern "C" {
#endif

typedef struct MixerConfig MixerConfig;
extern MixerConfig* mixer_config_default(void);
extern void mixer_config_free(MixerConfig* mixer_config);

typedef enum {
    MIXER_VOLUME_CONTROL_CUBIC = 0,
    MIXER_VOLUME_CONTROL_FIXED = 1,
    MIXER_VOLUME_CONTROL_LINEAR = 2,
    MIXER_VOLUME_CONTROL_LOG = 3
} MixerVolumeControl;

extern LibrespotStatus mixer_config_set_device(MixerConfig* mixer_config, const char* device);
extern LibrespotStatus mixer_config_set_control(MixerConfig* mixer_config, const char* control);
extern LibrespotStatus mixer_config_set_index(MixerConfig* mixer_config, uint32_t index);
extern LibrespotStatus mixer_config_set_volume_ctrl(MixerConfig* mixer_config, MixerVolumeControl control);
extern LibrespotStatus mixer_config_set_volume_ctrl_with_range(
    MixerConfig* mixer_config,
    MixerVolumeControl control,
    double db_range
);

typedef enum {
    MIXER_DEFAULT = 0,
    MIXER_SOFTVOL = 1,
@LIBRESPOT_MIXER_ENUMS@} MixerType;

typedef enum {
    BACKEND_DEFAULT = 0,
    BACKEND_RODIO = 1,@LIBRESPOT_BACKEND_ENUMS@
    BACKEND_PIPE = 9,
    BACKEND_SUBPROCESS = 10
} AudioBackend;

typedef struct Mixer Mixer;
extern Mixer* mixer_new(MixerConfig* mixer_config, MixerType mixer_type);
extern void mixer_free(Mixer* mixer);
extern uint16_t mixer_get_volume(Mixer* mixer);
extern LibrespotStatus mixer_set_volume(Mixer* mixer, uint16_t volume);

typedef struct PlayerConfig PlayerConfig;
extern PlayerConfig* player_config_default(void);
extern void player_config_free(PlayerConfig* player_config);

typedef enum {
    PLAYER_BITRATE_96 = 96,
    PLAYER_BITRATE_160 = 160,
    PLAYER_BITRATE_320 = 320
} PlayerBitrate;

typedef enum {
    PLAYER_NORMALISATION_TYPE_ALBUM = 0,
    PLAYER_NORMALISATION_TYPE_TRACK = 1,
    PLAYER_NORMALISATION_TYPE_AUTO = 2
} PlayerNormalisationType;

typedef enum {
    PLAYER_NORMALISATION_METHOD_BASIC = 0,
    PLAYER_NORMALISATION_METHOD_DYNAMIC = 1
} PlayerNormalisationMethod;

typedef enum {
    PLAYER_DITHERER_NONE = 0,
    PLAYER_DITHERER_TRIANGULAR = 1
} PlayerDitherer;

extern LibrespotStatus player_config_set_bitrate(PlayerConfig* player_config, PlayerBitrate bitrate);
extern LibrespotStatus player_config_set_gapless(PlayerConfig* player_config, bool gapless);
extern LibrespotStatus player_config_set_passthrough(PlayerConfig* player_config, bool passthrough);
extern LibrespotStatus player_config_set_normalisation(PlayerConfig* player_config, bool normalisation);
extern LibrespotStatus player_config_set_normalisation_type(
    PlayerConfig* player_config,
    PlayerNormalisationType type
);
extern LibrespotStatus player_config_set_normalisation_method(
    PlayerConfig* player_config,
    PlayerNormalisationMethod method
);
extern LibrespotStatus player_config_set_normalisation_pregain_db(
    PlayerConfig* player_config,
    double value
);
extern LibrespotStatus player_config_set_normalisation_threshold_dbfs(
    PlayerConfig* player_config,
    double value
);
extern LibrespotStatus player_config_set_normalisation_attack_cf(
    PlayerConfig* player_config,
    double value
);
extern LibrespotStatus player_config_set_normalisation_release_cf(
    PlayerConfig* player_config,
    double value
);
extern LibrespotStatus player_config_set_normalisation_knee_db(
    PlayerConfig* player_config,
    double value
);
extern LibrespotStatus player_config_set_position_update_interval(
    PlayerConfig* player_config,
    uint32_t interval_ms
);
extern LibrespotStatus player_config_clear_position_update_interval(PlayerConfig* player_config);
extern LibrespotStatus player_config_add_local_file_directory(
    PlayerConfig* player_config,
    const char* path
);
extern LibrespotStatus player_config_clear_local_file_directories(PlayerConfig* player_config);
extern LibrespotStatus player_config_set_ditherer(
    PlayerConfig* player_config,
    PlayerDitherer ditherer
);

typedef struct Player Player;
extern Player* player_new(
    PlayerConfig* player_config,
    Session* session,
    Mixer* mixer,
    AudioBackend audio_backend
);
extern void player_free(Player* player);
extern bool player_is_valid(Player* player);
extern LibrespotStatus player_load(Player* player, const char* spotify_uri, bool start_playing, uint32_t position_ms);
extern LibrespotStatus player_preload(Player* player, const char* spotify_uri);
extern LibrespotStatus player_play(Player* player);
extern LibrespotStatus player_pause(Player* player);
extern LibrespotStatus player_seek(Player* player, uint32_t position_ms);

typedef enum {
    PLAYER_EVENT_NONE,
    PLAYER_EVENT_PLAY_REQUEST_ID_CHANGED,
    PLAYER_EVENT_STOPPED,
    PLAYER_EVENT_LOADING,
    PLAYER_EVENT_PRELOADING,
    PLAYER_EVENT_PLAYING,
    PLAYER_EVENT_PAUSED,
    PLAYER_EVENT_TIME_TO_PRELOAD_NEXT_TRACK,
    PLAYER_EVENT_END_OF_TRACK,
    PLAYER_EVENT_UNAVAILABLE,
    PLAYER_EVENT_VOLUME_CHANGED,
    PLAYER_EVENT_POSITION_CORRECTION,
    PLAYER_EVENT_POSITION_CHANGED,
    PLAYER_EVENT_SEEKED,
    PLAYER_EVENT_TRACK_CHANGED,
    PLAYER_EVENT_SESSION_CONNECTED,
    PLAYER_EVENT_SESSION_DISCONNECTED,
    PLAYER_EVENT_SESSION_CLIENT_CHANGED,
    PLAYER_EVENT_SHUFFLE_CHANGED,
    PLAYER_EVENT_REPEAT_CHANGED,
    PLAYER_EVENT_AUTO_PLAY_CHANGED,
    PLAYER_EVENT_FILTER_EXPLICIT_CONTENT_CHANGED,
    PLAYER_EVENT_SET_QUEUE
} PlayerEventType;

typedef enum {
    PLAYER_IMAGE_SIZE_DEFAULT = 0,
    PLAYER_IMAGE_SIZE_SMALL = 1,
    PLAYER_IMAGE_SIZE_LARGE = 2,
    PLAYER_IMAGE_SIZE_XLARGE = 3
} PlayerImageSize;

typedef struct {
    const char* url;
    PlayerImageSize size;
    int32_t width;
    int32_t height;
} PlayerCoverImage;

typedef enum {
    PLAYER_ARTIST_ROLE_UNKNOWN = 0,
    PLAYER_ARTIST_ROLE_MAIN_ARTIST = 1,
    PLAYER_ARTIST_ROLE_FEATURED_ARTIST = 2,
    PLAYER_ARTIST_ROLE_REMIXER = 3,
    PLAYER_ARTIST_ROLE_ACTOR = 4,
    PLAYER_ARTIST_ROLE_COMPOSER = 5,
    PLAYER_ARTIST_ROLE_CONDUCTOR = 6,
    PLAYER_ARTIST_ROLE_ORCHESTRA = 7
} PlayerArtistRole;

typedef struct {
    SpotifyUri* id;
    const char* name;
    PlayerArtistRole role;
} PlayerArtist;

typedef enum {
    PLAYER_AUDIO_FILE_FORMAT_OGG_VORBIS_96 = 0,
    PLAYER_AUDIO_FILE_FORMAT_OGG_VORBIS_160 = 1,
    PLAYER_AUDIO_FILE_FORMAT_OGG_VORBIS_320 = 2,
    PLAYER_AUDIO_FILE_FORMAT_MP3_256 = 3,
    PLAYER_AUDIO_FILE_FORMAT_MP3_320 = 4,
    PLAYER_AUDIO_FILE_FORMAT_MP3_160 = 5,
    PLAYER_AUDIO_FILE_FORMAT_MP3_96 = 6,
    PLAYER_AUDIO_FILE_FORMAT_MP3_160_ENC = 7,
    PLAYER_AUDIO_FILE_FORMAT_AAC_24 = 8,
    PLAYER_AUDIO_FILE_FORMAT_AAC_48 = 9,
    PLAYER_AUDIO_FILE_FORMAT_FLAC_FLAC = 10,
    PLAYER_AUDIO_FILE_FORMAT_XHE_AAC_24 = 11,
    PLAYER_AUDIO_FILE_FORMAT_XHE_AAC_16 = 12,
    PLAYER_AUDIO_FILE_FORMAT_XHE_AAC_12 = 13,
    PLAYER_AUDIO_FILE_FORMAT_FLAC_FLAC_24BIT = 14,
    PLAYER_AUDIO_FILE_FORMAT_AAC_160 = 15,
    PLAYER_AUDIO_FILE_FORMAT_AAC_320 = 16,
    PLAYER_AUDIO_FILE_FORMAT_MP4_128 = 17,
    PLAYER_AUDIO_FILE_FORMAT_OTHER5 = 18
} PlayerAudioFileFormat;

typedef struct {
    PlayerAudioFileFormat format;
    uint8_t file_id[20];
} PlayerAudioFile;

typedef enum {
    PLAYER_UNAVAILABILITY_REASON_NONE = -1,
    PLAYER_UNAVAILABILITY_REASON_BLACKLISTED = 0,
    PLAYER_UNAVAILABILITY_REASON_EMBARGO = 1,
    PLAYER_UNAVAILABILITY_REASON_NO_DATA = 2,
    PLAYER_UNAVAILABILITY_REASON_NOT_WHITELISTED = 3
} PlayerUnavailabilityReason;

typedef enum {
    PLAYER_UNIQUE_FIELDS_TRACK = 0,
    PLAYER_UNIQUE_FIELDS_LOCAL = 1,
    PLAYER_UNIQUE_FIELDS_EPISODE = 2
} PlayerUniqueFieldsKind;

typedef struct {
    const char* album;
    PlayerArtist* artists;
    size_t artists_count;
    const char** album_artists;
    size_t album_artists_count;
    uint8_t popularity;
    uint32_t number;
    uint32_t disc_number;
} PlayerTrackFields;

typedef struct {
    const char* artists;
    const char* album;
    const char* album_artists;
    bool has_number;
    uint32_t number;
    bool has_disc_number;
    uint32_t disc_number;
    const char* path;
} PlayerLocalFields;

typedef struct {
    const char* description;
    int64_t publish_time_ms;
    const char* show_name;
} PlayerEpisodeFields;

typedef union {
    PlayerTrackFields track;
    PlayerLocalFields local;
    PlayerEpisodeFields episode;
} PlayerUniqueFieldsData;

typedef struct {
    PlayerUniqueFieldsKind kind;
    PlayerUniqueFieldsData data;
} PlayerUniqueFields;

typedef struct {
    SpotifyUri* track_id;
    const char* uri;
    const char* name;
    uint32_t duration_ms;
    bool is_explicit;
    PlayerCoverImage* covers;
    size_t covers_count;
    const char** language;
    size_t language_count;
    PlayerAudioFile* files;
    size_t files_count;
    SpotifyUri** alternatives;
    size_t alternatives_count;
    PlayerUnavailabilityReason availability;
    PlayerUniqueFields unique_fields;
} PlayerAudioItem;

typedef struct {
    const char* uri;
    const char* provider;
} PlayerQueueTrack;

typedef struct {
    uint64_t play_request_id;
} PlayerEventPlayRequestIdChanged;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
} PlayerEventStopped;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
    uint32_t position_ms;
} PlayerEventLoading;

typedef struct {
    SpotifyUri* track_id;
} PlayerEventPreloading;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
    uint32_t position_ms;
} PlayerEventPlaying;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
    uint32_t position_ms;
} PlayerEventPaused;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
} PlayerEventTimeToPreloadNextTrack;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
} PlayerEventEndOfTrack;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
} PlayerEventUnavailable;

typedef struct {
    uint16_t volume;
} PlayerEventVolumeChanged;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
    uint32_t position_ms;
} PlayerEventPositionCorrection;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
    uint32_t position_ms;
} PlayerEventPositionChanged;

typedef struct {
    uint64_t play_request_id;
    SpotifyUri* track_id;
    uint32_t position_ms;
} PlayerEventSeeked;

typedef struct {
    PlayerAudioItem audio_item;
} PlayerEventTrackChanged;

typedef struct {
    const char* connection_id;
    const char* user_name;
} PlayerEventSessionConnected;

typedef struct {
    const char* connection_id;
    const char* user_name;
} PlayerEventSessionDisconnected;

typedef struct {
    const char* client_id;
    const char* client_name;
    const char* client_brand_name;
    const char* client_model_name;
} PlayerEventSessionClientChanged;

typedef struct {
    bool shuffle;
} PlayerEventShuffleChanged;

typedef struct {
    bool context;
    bool track;
} PlayerEventRepeatChanged;

typedef struct {
    bool auto_play;
} PlayerEventAutoPlayChanged;

typedef struct {
    bool filter;
} PlayerEventFilterExplicitContentChanged;

typedef struct {
    const char* context_uri;
    bool has_current_track;
    PlayerQueueTrack current_track;
    PlayerQueueTrack* next_tracks;
    size_t next_tracks_count;
    PlayerQueueTrack* previous_tracks;
    size_t previous_tracks_count;
} PlayerEventSetQueue;

typedef union {
    PlayerEventPlayRequestIdChanged play_request_id_changed;
    PlayerEventStopped stopped;
    PlayerEventLoading loading;
    PlayerEventPreloading preloading;
    PlayerEventPlaying playing;
    PlayerEventPaused paused;
    PlayerEventTimeToPreloadNextTrack time_to_preload_next_track;
    PlayerEventEndOfTrack end_of_track;
    PlayerEventUnavailable unavailable;
    PlayerEventVolumeChanged volume_changed;
    PlayerEventPositionCorrection position_correction;
    PlayerEventPositionChanged position_changed;
    PlayerEventSeeked seeked;
    PlayerEventTrackChanged track_changed;
    PlayerEventSessionConnected session_connected;
    PlayerEventSessionDisconnected session_disconnected;
    PlayerEventSessionClientChanged session_client_changed;
    PlayerEventShuffleChanged shuffle_changed;
    PlayerEventRepeatChanged repeat_changed;
    PlayerEventAutoPlayChanged auto_play_changed;
    PlayerEventFilterExplicitContentChanged filter_explicit_content_changed;
    PlayerEventSetQueue set_queue;
} PlayerEventData;

typedef struct {
    PlayerEventType event;
    PlayerEventData data;
} PlayerEvent;
extern PlayerEvent* player_event_new(void);
extern void player_event_free(PlayerEvent* player_event);

typedef struct PlayerChannel PlayerChannel;
extern PlayerChannel* player_channel_get(Player* player);
extern void player_channel_free(PlayerChannel* player_channel);
extern bool player_channel_poll(PlayerChannel* player_channel, PlayerEvent* player_event);


#ifdef __cplusplus
}
#endif

#endif // LIBRESPOT_PLAYBACK_H
